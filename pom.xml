<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zenika.tech-lab</groupId>
    <artifactId>tech-lab-ingester</artifactId>
    <version>local-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>common</module>
        <module>libraries-reader</module>
        <module>indicator-computations-interface</module>
        <module>github-indicator-computer</module>
        <module>download-indicator-computer</module>
        <module>stackexchange-indicator-computer</module>
        <module>indicator-computations-orchestrator</module>
        <module>exporter</module>
        <module>main</module>
    </modules>

    <properties>
        <quarkus.package.jar.type>uber-jar</quarkus.package.jar.type>
        <revision>local-SNAPSHOT</revision>
        <compiler-plugin.version>3.13.0</compiler-plugin.version>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Framework Versions -->
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.30.5</quarkus.platform.version>
        <camel.version>4.16.0</camel.version>
        <jilt.version>1.9</jilt.version>
        <jacoco.version>0.8.12</jacoco.version>
        <surefire-plugin.version>3.5.0</surefire-plugin.version>

        <!-- Default Enforcer Properties (Override in CI/CD or CLI) -->
        <tech-lab-ingester.stackexchange.api.key>NONE</tech-lab-ingester.stackexchange.api.key>
        <tech-lab-ingester.github.token>NONE</tech-lab-ingester.github.token>
        <tech-lab-ingester.libraries.io.token>NONE</tech-lab-ingester.libraries.io.token>
        <tech-lab-ingester.bigQuery.projectId>NONE</tech-lab-ingester.bigQuery.projectId>

        <skipITs>true</skipITs>
        <jacoco.covered.instructions.target.percentage>0.19</jacoco.covered.instructions.target.percentage>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 1. Quarkus Platform BOM -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 2. Quarkus Camel BOM -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-camel-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 3. Camel Core BOM -->
            <dependency>
                <groupId>org.apache.camel</groupId>
                <artifactId>camel-bom</artifactId>
                <version>${camel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 4. Quarkiverse & Third-party Libraries -->
            <dependency>
                <groupId>io.hawt</groupId>
                <artifactId>hawtio-quarkus</artifactId>
                <version>4.6.2</version>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.bucket4j</groupId>
                <artifactId>quarkus-bucket4j</artifactId>
                <version>1.0.7</version>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.jdbc</groupId>
                <artifactId>quarkus-jdbc-sqlite</artifactId>
                <version>3.0.11</version>
            </dependency>
            <dependency>
                <groupId>io.smallrye</groupId>
                <artifactId>smallrye-graphql-client-generator</artifactId>
                <version>2.16.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.camel</groupId>
                <artifactId>camel-google-storage</artifactId>
                <version>${camel.version}</version>
            </dependency>

            <!-- 5. Utility Libraries -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-collections4</artifactId>
                <version>4.4</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.17.0</version>
            </dependency>
            <dependency>
                <groupId>cc.jilt</groupId>
                <artifactId>jilt</artifactId>
                <version>${jilt.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- 6. Test Dependencies -->
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>3.27.3</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <defaultGoal>verify</defaultGoal>
        <pluginManagement>
            <plugins>
                <!-- Quarkus Plugin configured here, applied only in runnable modules (e.g. main) -->
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                    <extensions>true</extensions>
                    <configuration>
                        <systemProperties>
                            <api.version>1.44</api.version>
                            <tech-lab-ingester.stackexchange.api.key>${tech-lab-ingester.stackexchange.api.key}</tech-lab-ingester.stackexchange.api.key>
                            <tech-lab-ingester.github.token>${tech-lab-ingester.github.token}</tech-lab-ingester.github.token>
                            <tech-lab-ingester.libraries.io.token>${tech-lab-ingester.libraries.io.token}</tech-lab-ingester.libraries.io.token>
                        </systemProperties>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>build</goal>
                                <goal>generate-code</goal>
                                <goal>generate-code-tests</goal>
                                <goal>native-image-agent</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Maven Enforcer Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>21</version>
                                </requireJavaVersion>
                                <requireProperty>
                                    <property>tech-lab-ingester.stackexchange.api.key</property>
                                    <message>tech-lab-ingester.stackexchange.api.key must be specified.</message>
                                </requireProperty>
                                <requireProperty>
                                    <property>tech-lab-ingester.libraries.io.token</property>
                                    <message>tech-lab-ingester.libraries.io.token must be specified.</message>
                                </requireProperty>
                                <requireProperty>
                                    <property>tech-lab-ingester.github.token</property>
                                    <message>tech-lab-ingester.github.token must be specified.</message>
                                </requireProperty>
                                <requireProperty>
                                    <property>tech-lab-ingester.bigQuery.projectId</property>
                                    <message>tech-lab-ingester.bigQuery.projectId must be specified.</message>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo Coverage Plugin -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/librariesio/model/*</exclude>
                        <exclude>**/ingester/model/*</exclude>
                        <exclude>**/github/model/*</exclude>
                        <exclude>**/stackoverflow/model/*</exclude>
                        <exclude>**/annotations/*</exclude>
                        <exclude>**/enums/*</exclude>
                        <exclude>**/exceptions/*</exclude>
                        <exclude>**/*.docx</exclude>
                        <exclude>**/*.xlsx</exclude>
                        <exclude>**/*.jks</exclude>
                        <exclude>**/*.png</exclude>
                        <exclude>**/*.ttf</exclude>
                        <exclude>**/*.woff</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>Jacoco - prepare agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>Jacoco - generate report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <phase>test</phase>
                    </execution>
                    <execution>
                        <id>Jacoco - is code covered?</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.covered.instructions.target.percentage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Compiler Plugin -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>cc.jilt</groupId>
                            <artifactId>jilt</artifactId>
                            <version>${jilt.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Surefire Plugin -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>1.44</api.version>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                        <tech-lab-ingester.github.token>${tech-lab-ingester.github.token}</tech-lab-ingester.github.token>
                        <tech-lab-ingester.stackexchange.api.key>${tech-lab-ingester.stackexchange.api.key}</tech-lab-ingester.stackexchange.api.key>
                        <tech-lab-ingester.libraries.io.token>${tech-lab-ingester.libraries.io.token}</tech-lab-ingester.libraries.io.token>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Failsafe Plugin -->
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <url>https://riduidel.github.io/tech-lab-ingester/</url>
    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Riduidel</id>
            <name>Nicolas Delsaux</name>
            <email>nicolas.delsaux@gmx.fr</email>
            <roles>
                <role>Tech Lead</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://git@github.com/Riduidel/tech-lab-ingester.git</connection>
        <developerConnection>scm:git:https://git@github.com/Riduidel/tech-lab-ingester.git</developerConnection>
        <url>https://github.com/Riduidel/tech-lab-ingester.git</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/Riduidel/tech-lab-ingester/issues</url>
    </issueManagement>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Riduidel/tech-lab-ingester</url>
        </repository>
    </distributionManagement>

    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>

        <profile>
            <id>generate-json-client</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jsonschema2pojo</groupId>
                        <artifactId>jsonschema2pojo-maven-plugin</artifactId>
                        <version>1.2.2</version>
                        <configuration>
                            <sourceDirectory>${basedir}/src/build/resources/examples</sourceDirectory>
                            <targetPackage>com.zenika.tech.lab.ingester.librariesio.model</targetPackage>
                            <sourceType>json</sourceType>
                            <useJakartaValidation>true</useJakartaValidation>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>update-target-coverage</id>
            <activation>
                <file>
                    <exists>target/site/jacoco/index.html</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.gmaven</groupId>
                        <artifactId>groovy-maven-plugin</artifactId>
                        <version>2.1.1</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.jsoup</groupId>
                                <artifactId>jsoup</artifactId>
                                <version>1.22.1</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>update jacoco treshold from test results</id>
                                <goals>
                                    <goal>execute</goal>
                                </goals>
                                <phase>verify</phase>
                                <configuration>
                                    <source>build/groovy/updateJacocoTarget.groovy</source>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>Make my code spotless!</id>
            <activation>
                <file>
                    <exists>pom.xml</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.diffplug.spotless</groupId>
                        <artifactId>spotless-maven-plugin</artifactId>
                        <version>2.43.0</version>
                        <configuration>
                            <pom>
                                <sortPom>
                                    <encoding>UTF-8</encoding>
                                    <indentSchemaLocation>true</indentSchemaLocation>
                                    <predefinedSortOrder>custom_1</predefinedSortOrder>
                                    <sortDependencies>scope,groupId,artifactId</sortDependencies>
                                    <nrOfIndentSpace>4</nrOfIndentSpace>
                                </sortPom>
                            </pom>
                        </configuration>
                        <executions>
                            <execution>
                                <id>Perform all formatting operations at once</id>
                                <goals>
                                    <goal>apply</goal>
                                </goals>
                                <phase>process-sources</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
